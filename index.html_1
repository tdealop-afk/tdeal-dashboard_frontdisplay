<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>프론트 전시 현황판</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f5f6f8; --card:#ffffff; --text:#1b1d22; --muted:#6b7280; --line:#e5e7eb;
  --accent:#e4002b; --done:#16a34a; --prog:#2563eb; --todo:#9ca3af; --risk:#dc2626;
  --chip:#f1f3f6; --overlay:rgba(0,0,0,.45);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1115; --card:#181b21; --text:#e8eaed; --muted:#9aa1ad; --line:#2a2f38; --chip:#222730; --overlay:rgba(0,0,0,.65);
  }
}
:root[data-theme="dark"]{
  --bg:#0f1115; --card:#181b21; --text:#e8eaed; --muted:#9aa1ad; --line:#2a2f38; --chip:#222730; --overlay:rgba(0,0,0,.65);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font-family:Pretendard,-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  font-size:14px;line-height:1.45}
.wrap{max-width:1280px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:18px}
h1{font-size:22px;margin:0;font-weight:700}
h1 span{color:var(--accent)}
.sub{color:var(--muted);font-size:12px;margin-top:4px}
.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
button,select,input,textarea{font:inherit;color:var(--text);background:var(--card);border:1px solid var(--line);
  border-radius:8px;padding:7px 12px}
button{cursor:pointer}
button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}
button.ghost{background:transparent}
button.danger{color:var(--risk);border-color:var(--risk);background:transparent}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;min-width:0}
.card h2{font-size:15px;margin:0 0 12px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.card h2 small{color:var(--muted);font-weight:400;font-size:12px}
.empty{color:var(--muted);padding:14px 0;text-align:center}
.legend{display:flex;gap:14px;font-size:12px;color:var(--muted);margin-top:12px;flex-wrap:wrap}
.legend em{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.week{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.day{border:1px solid var(--line);border-radius:10px;padding:8px;min-height:160px;min-width:0}
.day.today{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.day .dh{font-size:12px;color:var(--muted);margin-bottom:6px;display:flex;justify-content:space-between;align-items:center}
.day .dh b{color:var(--text)}
.day .add{opacity:0;border:0;padding:0 4px;font-size:14px;color:var(--muted);background:none}
.day:hover .add{opacity:1}
.ev{font-size:12px;border-radius:6px;padding:4px 6px;margin-bottom:4px;background:var(--chip);cursor:pointer;
  border-left:3px solid var(--todo);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ev.done{border-left-color:var(--done)} .ev.prog{border-left-color:var(--prog)}
.weeknav{display:flex;gap:6px}
.weeknav button{padding:4px 10px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.filters input{flex:1;min-width:160px}
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:920px}
th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:600;font-size:12px;white-space:nowrap;cursor:pointer;user-select:none}
td.nowrap{white-space:nowrap}
tbody tr:hover{background:var(--chip)}
select.st{padding:3px 6px;font-size:12px;border-radius:999px;font-weight:600}
select.st.done{color:var(--done);border-color:var(--done)}
select.st.prog{color:var(--prog);border-color:var(--prog)}
select.st.todo{color:var(--muted)}
.links a{color:var(--prog);text-decoration:none;margin-right:6px;font-size:12px}
.links a:hover{text-decoration:underline}
.edit-btn{padding:3px 9px;font-size:12px}
.note{background:var(--chip);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:var(--muted)}
/* 모달 */
.modal{position:fixed;inset:0;background:var(--overlay);display:none;align-items:center;justify-content:center;padding:16px;z-index:50}
.modal.open{display:flex}
.sheet{background:var(--card);border-radius:14px;width:100%;max-width:640px;max-height:92vh;overflow:auto;padding:20px}
.sheet h3{margin:0 0 14px;font-size:17px}
.form{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form label{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--muted)}
.form label.full{grid-column:1/-1}
.form input,.form select,.form textarea{width:100%;color:var(--text)}
.form .req::after{content:" *";color:var(--accent)}
.sheet .foot{display:flex;justify-content:space-between;gap:8px;margin-top:18px;flex-wrap:wrap}
.sheet .foot div{display:flex;gap:8px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#111;color:#fff;padding:10px 16px;
  border-radius:10px;font-size:13px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:60}
.toast.show{opacity:1}
@media (max-width:980px){ .week{grid-template-columns:repeat(2,1fr)} }
@media (max-width:560px){ .form{grid-template-columns:1fr} }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1><span>T deal</span> 프론트 전시 현황판</h1>
      <div class="sub" id="sub"></div>
    </div>
    <div class="actions">
      <button id="themeBtn" class="ghost" title="테마 전환">🌓</button>
      <button id="exportBtn">엑셀로 내보내기</button>
      <button id="importBtn">불러오기</button>
      <input type="file" id="importFile" accept=".csv,text/csv" hidden>
      <button class="primary" id="addBtn">+ 구좌 추가</button>
    </div>
  </header>

  <div class="note">입력한 내용은 <b>이 브라우저에만</b> 저장돼요. 다른 PC로 옮기거나 백업하려면 「엑셀로 내보내기」 → 다른 곳에서 「불러오기」 하세요. 브라우저 방문 기록·사이트 데이터를 지우면 함께 지워지니 가끔 백업해 두세요.</div>

  <section class="card" style="margin-bottom:16px">
    <h2>
      <span>주간 전시 캘린더 <small id="weekLabel"></small></span>
      <span class="weeknav">
        <button id="prevW">◀</button><button id="thisW">이번 주</button><button id="nextW">▶</button>
      </span>
    </h2>
    <div class="week" id="week"></div>
    <div class="legend">
      <span><em style="background:var(--done)"></em>완료</span>
      <span><em style="background:var(--prog)"></em>진행 중</span>
      <span><em style="background:var(--todo)"></em>미요청</span>
    </div>
  </section>

  <section class="card">
    <h2>전체 현황 <small id="tblCount"></small></h2>
    <div class="filters">
      <input id="q" placeholder="구좌명·노출 영역·요청자 검색">
      <select id="fType"><option value="">구좌 구분 전체</option></select>
      <select id="fStatus">
        <option value="">상태 전체</option>
        <option value="done">완료</option>
        <option value="prog">진행 중</option>
        <option value="todo">미요청</option>
      </select>
    </div>
    <div class="tbl-wrap">
      <table>
        <thead><tr>
          <th data-k="date">전시일자 ↕</th><th data-k="type">구좌 구분</th><th data-k="name">구좌명</th>
          <th>노출 영역</th><th data-k="req">요청일</th><th data-k="fin">완료일</th>
          <th data-k="owner">요청자</th><th data-k="status">준비 여부</th><th>경로</th><th>참고</th><th></th>
        </tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </section>
</div>

<!-- 입력/수정 모달 -->
<div class="modal" id="modal">
  <div class="sheet">
    <h3 id="mTitle">구좌 추가</h3>
    <form class="form" id="form" autocomplete="off">
      <label><span class="req">전시일자</span><input type="date" name="date" required></label>
      <label><span class="req">구좌 구분</span><input name="type" list="typeList" required placeholder="예: 특가, 기획전, 이벤트"></label>
      <label class="full">구좌명<input name="name" placeholder="예: META WEEK"></label>
      <label class="full">노출 영역<input name="area" list="areaList" placeholder="예: 이벤트페이지, 메인(홈), 딜상세배너"></label>
      <label>제작 요청일<input type="date" name="req"></label>
      <label>제작 완료일<input type="date" name="fin"></label>
      <label>요청자<input name="owner" list="ownerList"></label>
      <label>준비 여부
        <select name="ready">
          <option value="">미입력</option>
          <option>진행중</option>
          <option>완료</option>
        </select>
      </label>
      <label class="full">기획안(경로)<input name="plan" placeholder="URL 또는 경로"></label>
      <label class="full">제작 완료(경로)<input name="made" placeholder="URL 또는 경로"></label>
      <label class="full">제작 본(경로)<input name="final" placeholder="URL 또는 경로"></label>
      <label class="full">참고<textarea name="note" rows="2"></textarea></label>
    </form>
    <div class="foot">
      <button class="danger" id="delBtn" type="button">삭제</button>
      <div>
        <button type="button" id="dupBtn">복제</button>
        <button type="button" id="cancelBtn">취소</button>
        <button class="primary" type="button" id="saveBtn">저장</button>
      </div>
    </div>
  </div>
</div>
<datalist id="typeList"></datalist><datalist id="areaList"></datalist><datalist id="ownerList"></datalist>
<div class="toast" id="toast"></div>

<script>
const STORE_KEY = "tdeal_front_dashboard_v1";
const FIELDS = ["date","type","name","area","req","fin","owner","plan","made","final","ready","note"];
const HEADERS = {date:"전시일자",type:"구좌 구분",name:"구좌명",area:"노출 영역",req:"제작 요청일",fin:"제작 완료일",
  owner:"요청자",plan:"기획안(경로)",made:"제작 완료(경로)",final:"제작 본(경로)",ready:"준비 여부",note:"참고"};
const DATE_FIELDS = ["date","req","fin"];
const DOW = ["일","월","화","수","목","금","토"];
const ST_LABEL = {done:"완료", prog:"진행 중", todo:"미요청"};

let ROWS = [], weekOffset = 0, sortKey = "date", sortAsc = true, editing = null;
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

/* ---------- 날짜 ---------- */
function today0(){ const d=new Date(); d.setHours(0,0,0,0); return d; }
const iso = d => d ? `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}` : "";
function parseDate(s){
  s = String(s ?? "").trim(); if(!s) return null;
  let m = s.match(/(\d{4})[.\-\/년\s]+(\d{1,2})[.\-\/월\s]+(\d{1,2})/);
  if(m) return new Date(+m[1], +m[2]-1, +m[3]);
  m = s.match(/(\d{1,2})\s*[월.\/-]\s*(\d{1,2})/);
  if(m){
    const t = today0(), d = new Date(t.getFullYear(), +m[1]-1, +m[2]);
    if(d - t > 183*86400000) d.setFullYear(d.getFullYear()-1);
    else if(t - d > 183*86400000) d.setFullYear(d.getFullYear()+1);
    return d;
  }
  return null;
}
const toISO = s => iso(parseDate(s));
const fmt = d => d ? `${d.getMonth()+1}/${d.getDate()}(${DOW[d.getDay()]})` : "-";

/* ---------- 저장소 ---------- */
function loadStore(){
  try{ ROWS = JSON.parse(localStorage.getItem(STORE_KEY) || "[]"); }catch(e){ ROWS = []; }
  if(!Array.isArray(ROWS)) ROWS = [];
}
function saveStore(){
  try{ localStorage.setItem(STORE_KEY, JSON.stringify(ROWS)); }
  catch(e){ alert("저장에 실패했어요. 브라우저가 사이트 데이터 저장을 막고 있는지 확인해 주세요."); }
}
const newId = () => Date.now().toString(36) + Math.random().toString(36).slice(2,7);

function statusOf(r){
  if(/완료|done/i.test(r.ready) || /^o$/i.test(r.ready)) return "done";
  if(r.ready || r.req) return "prog";
  return "todo";
}
const view = () => ROWS.map(r => ({...r, _date:parseDate(r.date), _req:parseDate(r.req), _fin:parseDate(r.fin), status:statusOf(r)}));

/* ---------- 입력/수정 ---------- */
function openModal(r, presetDate){
  editing = r || null;
  $("mTitle").textContent = r ? "구좌 수정" : "구좌 추가";
  $("delBtn").style.display = r ? "" : "none";
  $("dupBtn").style.display = r ? "" : "none";
  const f = $("form"); f.reset();
  if(r){
    FIELDS.forEach(k => {
      if(k === "ready"){
        if(r.ready && ![...f.elements["ready"].options].some(o => o.value===r.ready)) f.elements["ready"].add(new Option(r.ready, r.ready));
        f.elements["ready"].value = r.ready || "";
      } else f.elements[k].value = r[k] || "";
    });
  }else if(presetDate){
    f.elements["date"].value = presetDate;
  }
  $("modal").classList.add("open");
  setTimeout(() => (r ? f.elements["name"] : f.elements["date"]).focus(), 50);
}
function closeModal(){ $("modal").classList.remove("open"); editing = null; }

function formData(){
  const f = $("form"), d = {};
  FIELDS.forEach(k => d[k] = f.elements[k].value.trim());
  if(d.fin && !d.ready) d.ready = "완료";
  return d;
}

function save(){
  const f = $("form");
  if(!f.reportValidity()) return;
  const d = formData();
  if(editing){ Object.assign(ROWS.find(x => x.id===editing.id), d); toast("수정했어요"); }
  else { ROWS.push({id:newId(), ...d}); toast("추가했어요 ✅"); }
  saveStore(); closeModal(); refresh();
}

function duplicate(){
  if(!editing) return;
  const d = formData();
  editing = null;
  $("mTitle").textContent = "구좌 추가 (복제)";
  $("delBtn").style.display = "none"; $("dupBtn").style.display = "none";
  const f = $("form");
  // 복제 시 진행 정보는 비움
  ["req","fin","ready","made","final"].forEach(k => f.elements[k].value = "");
  f.elements["date"].focus();
  toast("내용을 복사했어요. 날짜 바꾸고 저장하세요");
}

function del(){
  if(!editing || !confirm(`'${editing.name || editing.type}' 구좌를 삭제할까요?`)) return;
  ROWS = ROWS.filter(x => x.id !== editing.id);
  saveStore(); closeModal(); refresh(); toast("삭제했어요");
}

function quickStatus(id, value){
  const r = ROWS.find(x => x.id===id); if(!r) return;
  r.ready = value;
  if(value === "완료" && !r.fin) r.fin = iso(today0());
  saveStore(); refresh(); toast("준비 여부를 바꿨어요");
}

/* ---------- 엑셀(CSV) 내보내기/불러오기 ---------- */
function csvCell(v){ v = String(v ?? ""); return /[",\n\r]/.test(v) ? `"${v.replace(/"/g,'""')}"` : v; }
function exportCSV(){
  if(!ROWS.length){ toast("내보낼 데이터가 없어요"); return; }
  const sorted = [...ROWS].sort((a,b) => (a.date||"").localeCompare(b.date||""));
  const lines = [FIELDS.map(k => HEADERS[k]).join(",")]
    .concat(sorted.map(r => FIELDS.map(k => csvCell(r[k])).join(",")));
  const blob = new Blob(["﻿" + lines.join("\r\n")], {type:"text/csv;charset=utf-8"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = `프론트전시현황_${iso(today0())}.csv`;
  a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

function parseCSV(text){
  text = text.replace(/^﻿/, "");
  const rows = []; let row = [], cell = "", q = false;
  for(let i=0;i<text.length;i++){
    const c = text[i];
    if(q){
      if(c === '"'){ if(text[i+1] === '"'){ cell += '"'; i++; } else q = false; }
      else cell += c;
    }else if(c === '"') q = true;
    else if(c === ","){ row.push(cell); cell = ""; }
    else if(c === "\n" || c === "\r"){
      if(c === "\r" && text[i+1] === "\n") i++;
      row.push(cell); rows.push(row); row = []; cell = "";
    }else cell += c;
  }
  if(cell || row.length){ row.push(cell); rows.push(row); }
  return rows;
}

function importCSV(file){
  const reader = new FileReader();
  reader.onload = () => {
    const rows = parseCSV(reader.result);
    const hi = rows.findIndex(r => r.some(c => c.replace(/\s/g,"") === "전시일자"));
    if(hi < 0){ alert("'전시일자' 헤더가 있는 CSV 파일이 아니에요."); return; }
    const head = rows[hi].map(c => c.replace(/\s/g,""));
    const idx = {};
    FIELDS.forEach(k => { idx[k] = head.indexOf(HEADERS[k].replace(/\s/g,"")); });
    const items = rows.slice(hi+1).map(r => {
      const o = {id:newId()};
      FIELDS.forEach(k => {
        const v = idx[k] >= 0 ? String(r[idx[k]] ?? "").replace(/[​-‍﻿]/g,"").trim() : "";
        o[k] = DATE_FIELDS.includes(k) ? (toISO(v) || v) : v;
      });
      return o;
    }).filter(o => o.date || o.type || o.name);
    if(!items.length){ alert("불러올 행이 없어요."); return; }
    const replace = ROWS.length && confirm(`${items.length}건을 불러왔어요.\n\n[확인] 기존 데이터를 지우고 바꾸기\n[취소] 기존 데이터에 추가하기`);
    ROWS = replace ? items : ROWS.concat(items);
    saveStore(); refresh(); toast(`${items.length}건 불러왔어요`);
  };
  reader.readAsText(file, "utf-8");
}

/* ---------- 렌더 ---------- */
function fillLists(){
  const uniq = k => [...new Set(ROWS.map(r => r[k]).filter(Boolean))].sort();
  const areas = [...new Set(ROWS.flatMap(r => (r.area||"").split(",").map(s=>s.trim())).filter(Boolean))].sort();
  $("typeList").innerHTML = uniq("type").map(v=>`<option value="${esc(v)}">`).join("");
  $("ownerList").innerHTML = uniq("owner").map(v=>`<option value="${esc(v)}">`).join("");
  $("areaList").innerHTML = areas.map(v=>`<option value="${esc(v)}">`).join("");
  const sel = $("fType"), cur = sel.value, types = uniq("type");
  sel.innerHTML = `<option value="">구좌 구분 전체</option>` + types.map(t=>`<option>${esc(t)}</option>`).join("");
  sel.value = types.includes(cur) ? cur : "";
}

function refresh(){
  fillLists();
  $("sub").textContent = `총 ${ROWS.length}건 · 이 브라우저에 자동 저장`;
  renderWeek(); renderTable();
}

function renderWeek(){
  const t0 = today0(), data = view();
  const mon = new Date(t0); mon.setDate(t0.getDate() - ((t0.getDay()+6)%7) + weekOffset*7);
  const days = [...Array(7)].map((_,i) => { const d = new Date(mon); d.setDate(mon.getDate()+i); return d; });
  $("weekLabel").textContent = `${fmt(days[0])} ~ ${fmt(days[6])}`;
  $("week").innerHTML = days.map(d => {
    const evs = data.filter(r => r._date && r._date.getTime()===d.getTime());
    return `<div class="day ${d.getTime()===t0.getTime()?"today":""}">
      <div class="dh"><b>${d.getMonth()+1}/${d.getDate()} ${DOW[d.getDay()]}</b>
        <span>${evs.length?evs.length+"건":""} <button class="add" data-date="${iso(d)}" title="이 날짜에 추가">＋</button></span></div>
      ${evs.map(r=>`<div class="ev ${r.status}" data-id="${r.id}" title="${esc(r.type)} · ${esc(r.name)} · ${ST_LABEL[r.status]}">${esc(r.type)}${r.name&&r.name!=="-"?" · "+esc(r.name):""}</div>`).join("")}
    </div>`;
  }).join("");
}

function linkify(label, v){
  if(!v) return "";
  return /^https?:\/\//i.test(v) ? `<a href="${esc(v)}" target="_blank" rel="noopener">${label}↗</a>`
    : `<span title="${esc(v)}" style="font-size:12px;color:var(--muted);margin-right:6px">${label}</span>`;
}

function statusCell(r){
  const opts = ["", "진행중", "완료"]; if(r.ready && !opts.includes(r.ready)) opts.push(r.ready);
  return `<select class="st ${r.status}" data-id="${r.id}">${opts.map(o=>`<option value="${esc(o)}" ${o===(r.ready||"")?"selected":""}>${o?esc(o):(r.status==="prog"?"진행 중(요청됨)":"미입력")}</option>`).join("")}</select>`;
}

function renderTable(){
  const q = $("q").value.trim().toLowerCase(), ft = $("fType").value, fs = $("fStatus").value;
  let list = view().filter(r => (!ft || r.type===ft) && (!fs || r.status===fs) &&
    (!q || [r.name,r.area,r.owner,r.type,r.note].join(" ").toLowerCase().includes(q)));
  const val = r => ({date:r._date?.getTime() ?? Infinity, req:r._req?.getTime() ?? Infinity, fin:r._fin?.getTime() ?? Infinity,
    status:{todo:0,prog:1,done:2}[r.status]})[sortKey] ?? (r[sortKey]||"");
  list.sort((a,b) => { const x=val(a), y=val(b); return (x>y?1:x<y?-1:0) * (sortAsc?1:-1); });
  $("tblCount").textContent = `${list.length}건`;
  $("tbody").innerHTML = list.length ? list.map(r => `<tr>
    <td class="nowrap">${r._date?fmt(r._date):esc(r.date)||"-"}</td>
    <td class="nowrap">${esc(r.type)}</td>
    <td>${esc(r.name)}</td>
    <td>${esc(r.area)}</td>
    <td class="nowrap">${r._req?fmt(r._req):esc(r.req)||"-"}</td>
    <td class="nowrap">${r._fin?fmt(r._fin):esc(r.fin)||"-"}</td>
    <td>${esc(r.owner)||"-"}</td>
    <td>${statusCell(r)}</td>
    <td class="links nowrap">${linkify("기획안",r.plan)}${linkify("완료",r.made)}${linkify("제작본",r.final)}</td>
    <td>${esc(r.note)}</td>
    <td><button class="edit-btn" data-id="${r.id}">수정</button></td>
  </tr>`).join("") : `<tr><td colspan="11" class="empty">${ROWS.length ? "조건에 맞는 구좌가 없어요" : "아직 등록된 구좌가 없어요. 「+ 구좌 추가」로 시작해 보세요"}</td></tr>`;
}

/* ---------- 이벤트 ---------- */
let tt; function toast(m){ const t=$("toast"); t.textContent=m; t.classList.add("show"); clearTimeout(tt); tt=setTimeout(()=>t.classList.remove("show"),2200); }

$("addBtn").onclick = () => openModal(null);
$("cancelBtn").onclick = closeModal;
$("saveBtn").onclick = save;
$("delBtn").onclick = del;
$("dupBtn").onclick = duplicate;
$("exportBtn").onclick = exportCSV;
$("importBtn").onclick = () => $("importFile").click();
$("importFile").onchange = e => { const f = e.target.files[0]; if(f) importCSV(f); e.target.value = ""; };
$("modal").addEventListener("click", e => { if(e.target.id==="modal") closeModal(); });
document.addEventListener("keydown", e => {
  if(e.key==="Escape") closeModal();
  if(e.key==="Enter" && (e.ctrlKey||e.metaKey) && $("modal").classList.contains("open")) save();
});
["q","fType","fStatus"].forEach(id => $(id).addEventListener("input", renderTable));
$("prevW").onclick = () => { weekOffset--; renderWeek(); };
$("nextW").onclick = () => { weekOffset++; renderWeek(); };
$("thisW").onclick = () => { weekOffset=0; renderWeek(); };
document.querySelectorAll("th[data-k]").forEach(th => th.onclick = () => {
  const k = th.dataset.k; sortAsc = sortKey===k ? !sortAsc : true; sortKey = k; renderTable();
});
document.body.addEventListener("click", e => {
  const add = e.target.closest(".add"); if(add){ openModal(null, add.dataset.date); return; }
  const el = e.target.closest(".edit-btn, .ev");
  if(el && el.dataset.id){ const r = ROWS.find(x => x.id===el.dataset.id); if(r) openModal(r); }
});
$("tbody").addEventListener("change", e => {
  if(e.target.matches("select.st")) quickStatus(e.target.dataset.id, e.target.value);
});
$("themeBtn").onclick = () => {
  const r = document.documentElement;
  const dark = r.dataset.theme ? r.dataset.theme==="dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  r.dataset.theme = dark ? "light" : "dark";
  try{ localStorage.setItem("theme", r.dataset.theme); }catch(e){}
};
try{ const t = localStorage.getItem("theme"); if(t) document.documentElement.dataset.theme = t; }catch(e){}
// 다른 탭에서 수정하면 자동 반영
window.addEventListener("storage", e => { if(e.key===STORE_KEY){ loadStore(); refresh(); } });

loadStore();
refresh();
</script>
</body>
</html>
